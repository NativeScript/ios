# Fail early with an accurate message when the toolchain is not set up — a
# missing tool must block the commit, not silently skip validation. Bypass
# deliberately with `git commit --no-verify` if you must.
if [ ! -x node_modules/.bin/eslint ]; then
  echo "pre-commit: node_modules missing — run 'npm install' first (or bypass explicitly with --no-verify)" >&2
  exit 1
fi
if ! command -v git-clang-format >/dev/null 2>&1; then
  echo "pre-commit: git-clang-format not found — install clang-format (e.g. 'brew install clang-format')" >&2
  exit 1
fi

# --no-install: only the repo-pinned lint-staged may run; a bare npx would
# fetch an arbitrary cached version when the local one is absent.
# Native sources are auto-formatted on the staged hunks only (see
# tools/format-staged-native.sh); JS goes through eslint.
npx --no-install lint-staged
